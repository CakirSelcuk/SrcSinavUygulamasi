<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SrcSinavUygulamasi.Views.AnalysisPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,30">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- HEADER                                                      -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid HeightRequest="120" Padding="20,50,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Text="←" 
                        FontSize="24" 
                        BackgroundColor="Transparent" 
                        TextColor="White"
                        WidthRequest="50"
                        HeightRequest="50"
                        Clicked="OnBackClicked"/>
                
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="📊 Performans Analizi" 
                           TextColor="White" 
                           FontSize="24" 
                           FontAttributes="Bold"/>
                    <Label x:Name="LblCategoryTitle" 
                           Text="Tüm Kategoriler" 
                           TextColor="#94a3b8" 
                           FontSize="14"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- EMPTY STATE (Veri yoksa gösterilir)                        -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="EmptyStateFrame"
                    IsVisible="False"
                    BackgroundColor="#1e293b"
                    StrokeShape="RoundRectangle 20"
                    Stroke="Transparent"
                    Padding="40"
                    Margin="20,20,20,20">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Label Text="📭" FontSize="64" HorizontalOptions="Center"/>
                    <Label Text="Henüz yeterli veri yok!" 
                           TextColor="White" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                    <Label Text="İlk sınavını çözünce burada performans analizini görebilirsin." 
                           TextColor="#94a3b8" 
                           FontSize="14" 
                           HorizontalTextAlignment="Center"
                           LineHeight="1.4"/>
                    <Button Text="🚀 Sınava Başla" 
                            BackgroundColor="#22c55e" 
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50"
                            Clicked="OnStartExamClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ANA İÇERİK (Veri varsa gösterilir)                         -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <VerticalStackLayout x:Name="MainContent" IsVisible="True" Spacing="16">

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- ÖZET KARTLARI                                           -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Margin="20,10,20,0" ColumnDefinitions="*, *, *" ColumnSpacing="12">
                    
                    <!-- Ortalama Puan -->
                    <Border Grid.Column="0" 
                            BackgroundColor="#1e293b" 
                            StrokeShape="RoundRectangle 16"
                            Stroke="Transparent"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000" Offset="0,4" Opacity="0.2" Radius="8"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="📈" FontSize="24" HorizontalOptions="Center"/>
                            <Label x:Name="LblAverageScore" 
                                   Text="0" 
                                   TextColor="#22c55e" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Ortalama" 
                                   TextColor="#94a3b8" 
                                   FontSize="10" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Çözülen Soru -->
                    <Border Grid.Column="1" 
                            BackgroundColor="#1e293b" 
                            StrokeShape="RoundRectangle 16"
                            Stroke="Transparent"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000" Offset="0,4" Opacity="0.2" Radius="8"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="❓" FontSize="24" HorizontalOptions="Center"/>
                            <Label x:Name="LblTotalQuestions" 
                                   Text="0" 
                                   TextColor="#3b82f6" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Soru" 
                                   TextColor="#94a3b8" 
                                   FontSize="10" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tamamlanan Sınav -->
                    <Border Grid.Column="2" 
                            BackgroundColor="#1e293b" 
                            StrokeShape="RoundRectangle 16"
                            Stroke="Transparent"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#000" Offset="0,4" Opacity="0.2" Radius="8"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="📝" FontSize="24" HorizontalOptions="Center"/>
                            <Label x:Name="LblTotalExams" 
                                   Text="0" 
                                   TextColor="#f59e0b" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Sınav" 
                                   TextColor="#94a3b8" 
                                   FontSize="10" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- BAŞARI ORANI                                            -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border BackgroundColor="#1e293b" 
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        Padding="20" 
                        Margin="20,0,20,0">
                    <Border.Shadow>
                        <Shadow Brush="#000" Offset="0,4" Opacity="0.2" Radius="8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="🎯 Başarı Oranı" 
                                   TextColor="White" 
                                   FontSize="16" 
                                   FontAttributes="Bold"/>
                            <Label x:Name="LblSuccessRate" 
                                   Grid.Column="1"
                                   Text="0%" 
                                   TextColor="#22c55e" 
                                   FontSize="16" 
                                   FontAttributes="Bold"/>
                        </Grid>
                        
                        <!-- Progress Bar -->
                        <Grid HeightRequest="12">
                            <Border BackgroundColor="#374151" 
                                    StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent"/>
                            <Border x:Name="SuccessRateBar"
                                    BackgroundColor="#22c55e" 
                                    StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent"
                                    HorizontalOptions="Start"
                                    WidthRequest="0"/>
                        </Grid>
                        
                        <Grid ColumnDefinitions="*, *">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="✓" TextColor="#22c55e" FontSize="14"/>
                                <Label x:Name="LblPassedCount" Text="0 Geçti" TextColor="#22c55e" FontSize="12"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                <Label Text="✗" TextColor="#ef4444" FontSize="14"/>
                                <Label x:Name="LblFailedCount" Text="0 Kaldı" TextColor="#ef4444" FontSize="12"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- SON 5 SINAV GELİŞİM GRAFİĞİ (Native Bar Chart)         -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border BackgroundColor="#1e293b" 
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        Padding="20" 
                        Margin="20,0,20,0">
                    <Border.Shadow>
                        <Shadow Brush="#000" Offset="0,4" Opacity="0.2" Radius="8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="📊 Son 5 Sınav" 
                               TextColor="White" 
                               FontSize="16" 
                               FontAttributes="Bold"/>
                        
                        <!-- Native Bar Chart Container -->
                        <Grid x:Name="BarChartContainer" 
                              HeightRequest="140"
                              ColumnDefinitions="*, *, *, *, *"
                              ColumnSpacing="8">
                            <!-- Bars will be added from code-behind -->
                        </Grid>
                        
                        <!-- 60 puan çizgisi referansı -->
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                            <BoxView Color="#f59e0b" WidthRequest="20" HeightRequest="3" VerticalOptions="Center"/>
                            <Label Text="60 puan barajı" TextColor="#94a3b8" FontSize="10"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- DİKKAT GEREKTİREN KONULAR                               -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border x:Name="WeakSubjectsFrame"
                        IsVisible="False"
                        BackgroundColor="#1e293b" 
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        Padding="20" 
                        Margin="20,0,20,0">
                    <Border.Shadow>
                        <Shadow Brush="#000" Offset="0,4" Opacity="0.2" Radius="8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="⚠️ Dikkat Gerektiren Konular" 
                               TextColor="White" 
                               FontSize="16" 
                               FontAttributes="Bold"/>
                        
                        <VerticalStackLayout x:Name="WeakSubjectsContainer" Spacing="12"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- SON AKTİVİTELER                                         -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border x:Name="RecentExamsFrame"
                        IsVisible="False"
                        BackgroundColor="#1e293b" 
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        Padding="20" 
                        Margin="20,0,20,0">
                    <Border.Shadow>
                        <Shadow Brush="#000" Offset="0,4" Opacity="0.2" Radius="8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🕐 Son Aktiviteler" 
                               TextColor="White" 
                               FontSize="16" 
                               FontAttributes="Bold"/>
                        
                        <VerticalStackLayout x:Name="RecentExamsContainer" Spacing="8"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
