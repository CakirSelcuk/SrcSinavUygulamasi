<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SrcSinavUygulamasi.ViewModels"
             xmlns:converters="clr-namespace:SrcSinavUygulamasi.Converters"
             x:Class="SrcSinavUygulamasi.Views.QuizPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
            
            <Style x:Key="OptionButtonStyle" TargetType="Button">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="60" />
                <Setter Property="BorderColor" Value="#475569" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.2"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{Binding ThemeColor}" Offset="0.0" />
            <GradientStop Color="#0f172a" Offset="0.8" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,40,20,20">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,20">
            <VerticalStackLayout Spacing="5">
                <Label Text="SINAV MODU" TextColor="#cbd5e1" FontSize="12" FontAttributes="Bold" CharacterSpacing="1"/>

                <HorizontalStackLayout Spacing="0" VerticalOptions="End">
                    <Label Text="{Binding QuestionNumber}" TextColor="White" FontSize="28" FontAttributes="Bold"/>
                    <Label Text="." TextColor="#64748b" FontSize="28" VerticalOptions="End"/>
                </HorizontalStackLayout>

                <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="White" BackgroundColor="#334155" 
                             HeightRequest="6" WidthRequest="100" HorizontalOptions="Start" Margin="0,5,0,0"/>
            </VerticalStackLayout>

            <!-- Timer -->
            <Border Grid.Column="1" Stroke="Transparent" BackgroundColor="#1e293b" StrokeShape="RoundRectangle 12" Padding="15,5" Margin="0,0,10,0"
                    IsVisible="{Binding IsTimerVisible}">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="SÜRE" TextColor="#94a3b8" FontSize="10" HorizontalOptions="Center"/>
                    <Label Text="{Binding TimerText}" TextColor="{Binding TimerColor}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Puan -->
            <Border Grid.Column="2" Stroke="Transparent" BackgroundColor="#1e293b" StrokeShape="RoundRectangle 12" Padding="15,5">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="PUAN" TextColor="#94a3b8" FontSize="10" HorizontalOptions="Center"/>
                    <Label Text="{Binding Score, StringFormat='{0:F0}'}" TextColor="#4ade80" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- GÖRSELLİ SORULAR İÇİN -->
        <Border Grid.Row="1" Stroke="Transparent" BackgroundColor="#1e293b" 
                StrokeShape="RoundRectangle 20" Padding="12" Margin="0,5,0,10"
                VerticalOptions="Fill"
                IsVisible="{Binding HasCurrentImage}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.5"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="8">
                <!-- Resim -->
                <Frame BackgroundColor="#0f172a" 
                       CornerRadius="12" 
                       Padding="5"
                       HeightRequest="150"
                       HasShadow="False">
                    <Image Source="{Binding CurrentImageSource}" 
                           Aspect="AspectFit"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Frame>
                
                <!-- Soru Metni -->
                <Label Text="{Binding CurrentQuestion.Soru}" 
                       TextColor="#f8fafc" 
                       FontSize="14" 
                       FontAttributes="Bold"
                       LineHeight="1.2"
                       VerticalOptions="Start" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center"
                       Padding="5,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- GÖRSELSİZ SORULAR İÇİN (Sadece Metin) -->
        <Border Grid.Row="1" Stroke="Transparent" BackgroundColor="#1e293b" 
                StrokeShape="RoundRectangle 20" Padding="25" Margin="0,10,0,20"
                VerticalOptions="Center"
                IsVisible="{Binding HasCurrentImage, Converter={StaticResource InvertBoolConverter}}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.5"/>
            </Border.Shadow>

            <ScrollView VerticalScrollBarVisibility="Never">
                <Label Text="{Binding CurrentQuestion.Soru}" 
                       TextColor="#f8fafc" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       LineHeight="1.3"
                       VerticalOptions="Center" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center"/>
            </ScrollView>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="15">
            <Button Text="{Binding CurrentQuestion.Siklar[0]}" 
                    Command="{Binding AnswerCommand}" CommandParameter="{Binding CurrentQuestion.Siklar[0]}"
                    BackgroundColor="{Binding BtnAColor}" 
                    Style="{StaticResource OptionButtonStyle}"/>

            <Button Text="{Binding CurrentQuestion.Siklar[1]}" 
                    Command="{Binding AnswerCommand}" CommandParameter="{Binding CurrentQuestion.Siklar[1]}"
                    BackgroundColor="{Binding BtnBColor}" 
                    Style="{StaticResource OptionButtonStyle}"/>

            <Button Text="{Binding CurrentQuestion.Siklar[2]}" 
                    Command="{Binding AnswerCommand}" CommandParameter="{Binding CurrentQuestion.Siklar[2]}"
                    BackgroundColor="{Binding BtnCColor}" 
                    Style="{StaticResource OptionButtonStyle}"/>

            <Button Text="{Binding CurrentQuestion.Siklar[3]}" 
                    Command="{Binding AnswerCommand}" CommandParameter="{Binding CurrentQuestion.Siklar[3]}"
                    BackgroundColor="{Binding BtnDColor}" 
                    Style="{StaticResource OptionButtonStyle}"/>
        </VerticalStackLayout>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" 
                           Color="White" HorizontalOptions="Center" VerticalOptions="Center" Grid.RowSpan="3"/>
    </Grid>
</ContentPage>