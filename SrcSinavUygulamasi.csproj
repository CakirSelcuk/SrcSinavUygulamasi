<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android35.0;net9.0-windows10.0.19041.0</TargetFrameworks>
		<AndroidFastDeployment>false</AndroidFastDeployment>
		<OutputType>Exe</OutputType>
		<RootNamespace>SrcSinavUygulamasi</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>SRC Sınav Uygulaması</ApplicationTitle>
		<ApplicationId>com.srcsinavuygulamasi.app</ApplicationId>
		<ApplicationIdGuid>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</ApplicationIdGuid>

		<ApplicationDisplayVersion>1.8.6</ApplicationDisplayVersion>
		<ApplicationVersion>73</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Android SDK Versions (Play Store gereksinimleri) -->
	<PropertyGroup Condition="$(TargetFramework.Contains('android'))">
		<!-- targetSdkVersion = 35 (Play Store 2024 gereksinimi) -->
		<AndroidSdkVersion>35</AndroidSdkVersion>
		<!-- minSdkVersion = 21 (Android 5.0 Lollipop) -->
		<!-- Zaten SupportedOSPlatformVersion ile 21.0 olarak ayarlı -->
		
		<!-- AdMob için gerekli ayarlar -->
		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
	</PropertyGroup>

	<!-- Android Release Signing -->
	<PropertyGroup Condition="$(TargetFramework.Contains('android')) and '$(Configuration)' == 'Release'">
		<!-- 16 KB page size support for Android 15+ -->
		<AndroidExtraLdFlags>-Wl,-z,common-page-size=16384 -Wl,-z,max-page-size=16384</AndroidExtraLdFlags>
		<AndroidUseNdk16KPageSize>true</AndroidUseNdk16KPageSize>
		<!-- Play Store release: yalnızca arm64 üret (16KB uyumu için en güvenli yol) -->
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>src-sinav-key.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>src-sinav</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>123456</AndroidSigningKeyPass>
		<AndroidSigningStorePass>123456</AndroidSigningStorePass>
		<!-- AAB build için -->
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<!-- Proguard configuration for AdMob -->
		<AndroidEnableProguard>false</AndroidEnableProguard>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
		<AndroidLinkResources>true</AndroidLinkResources>
	</PropertyGroup>

	<!-- App Icon -->
	<ItemGroup>
		<MauiIcon Include="Resources\Images\appicon.png"
		          ForegroundFile="Resources\Images\appicon.png"
		          ForegroundScale="0.65"
		          Color="#0f172a" />
	</ItemGroup>

	<!-- Splash Screen -->
	<ItemGroup>
		<MauiSplashScreen Include="Resources\Images\appicon.png" Color="#0f172a" BaseSize="128,128" />
	</ItemGroup>

	<!-- Exclude tools folder from build (helper scripts with their own Main) -->
	<ItemGroup>
	  <Compile Remove="tools\**" />
	  <None Include="tools\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Raw\sorular_src.json" />
	  <None Remove="Resources\Raw\sorular_src1.json" />
	  <None Remove="Resources\Raw\sorular_src1_sinav.json" />
	  <None Remove="Resources\Raw\sorular_src1_resimli.json" />
	  <None Remove="Resources\Raw\sorular_src2.json" />
	  <None Remove="Resources\Raw\sorular_src3.json" />
	  	<None Remove="Resources\Raw\sorular_src4.json" />
	  <None Remove="Resources\Raw\sorular_src5.json" />
	  <None Remove="Resources\Raw\sorular_src5_sinav.json" />
	  <None Remove="Resources\Raw\sorular_src5_resimli.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Plugin.InAppBilling" Version="8.0.5" />
		<PackageReference Include="Plugin.MauiMTAdmob" Version="1.3.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.120" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('android'))">
		<!-- Play Console AD_ID taraması için izin beyanını manifest merge'e zorla -->
		<UsesPermission Include="com.google.android.gms.permission.AD_ID" />
		<PackageReference Include="Xamarin.Android.Google.BillingClient" Version="7.0.0" />
		<!-- Fix Lifecycle dependency conflicts - upgrade to 2.8.3.1 to satisfy Plugin.InAppBilling -->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.8.7.3" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.8.7.3" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Service" Version="2.8.7.3" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="AppShell.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="NewPage1.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\CategoriesPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ResultPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\Fonts\" />
	  <Folder Include="Resources\Images\" />
	  <Folder Include="Resources\Styles\" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\Raw\sorular_src.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src1.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src1_sinav.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src1_resimli.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src2_resimli.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src3_resimli.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src3_sinav.json" />
	</ItemGroup>

	<!-- Resimli sorular için görseller -->
	<ItemGroup>
	  <MauiImage Include="Resources\Images\src1_*.png" />
	  <MauiImage Include="Resources\Images\src2_*.jpeg" />
	  <MauiImage Include="Resources\Images\src3_*.jpeg" />
	  <MauiImage Include="Resources\Images\src4_*.jpeg" />
	  <MauiImage Include="Resources\Images\src5_*.jpeg" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\Raw\sorular_src2.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src2_sinav.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src3.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src4.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src4_sinav.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src4_resimli.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src5.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src5_sinav.json" />
	  <EmbeddedResource Include="Resources\Raw\sorular_src5_resimli.json" />
	</ItemGroup>

</Project>
